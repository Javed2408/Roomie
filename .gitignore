# --- Secrets and local configuration (never commit these) ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Files the running backend creates: uploads and development emails ---
backend/var/

# --- Node / Next.js (frontend/.gitignore covers the rest) ---
node_modules/

# --- Editors and operating systems ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
