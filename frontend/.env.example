# Roomie — frontend environment configuration
#
# Copy this file to ".env.local" in the same folder.
# ".env.local" is ignored by Git and must never be committed.
#
# Anything starting with NEXT_PUBLIC_ is built into the JavaScript sent to
# the browser, so it is visible to every visitor. Never put a secret in a
# NEXT_PUBLIC_ variable.

# Address of the Roomie backend (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
