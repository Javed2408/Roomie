# Roomie — local environment configuration (database + backend)
#
# Copy this file to ".env" in the same folder, then change the password.
# The real ".env" file is ignored by Git and must never be committed.
#
# Both Docker Compose (which starts PostgreSQL) and the FastAPI backend read
# this one file, so the database credentials only live in one place.

# "development", "test" or "production"
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=roomie
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=roomie
# Where the backend finds the database. 127.0.0.1 means "this computer".
# Use the number rather than the name "localhost": on Windows "localhost" is
# tried over IPv6 first, where Docker is not listening, and every new
# connection then waits 5 seconds before falling back.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Backend ---
# Comma-separated list of website addresses allowed to call the API from a
# browser. This must include the address the frontend runs on.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Security ---
# Signs security tokens. Must be long, random and private. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-64-random-hex-characters

# Where the frontend runs. Used to build the links placed in emails.
FRONTEND_URL=http://localhost:3000

# --- Email ---
# "console" sends nothing: each email is saved as a text file in
# backend/var/outbox/ so you can open it and click its link. Use "smtp" with
# the settings below to send real email (required in production).
EMAIL_BACKEND=console
EMAIL_FROM=Roomie <no-reply@roomie.example>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- Private document storage ---
# Verification documents are saved in backend/var/private-storage/ by default.
# Maximum upload size in bytes (default 5 MB).
# MAX_UPLOAD_BYTES=5242880
